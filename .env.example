# Run npm run setup to create real, private local configuration.
DATABASE_URL=postgres://preflight:replace-with-generated-password@127.0.0.1:55432/preflight
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_PORT=55432
PREFLIGHT_PORT=3000
PREFLIGHT_HOST=127.0.0.1
PREFLIGHT_AUTH_FILE=.preflight/auth.json
# Allowed request Host/Origin, including your deployment hostname if remote.
PREFLIGHT_ALLOWED_HOSTS=127.0.0.1,localhost
