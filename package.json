{
  "name": "preflight",
  "version": "0.1.0",
  "private": true,
  "description": "A shared MCP collaboration server for coding teams",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/src/index.js",
    "db:migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file=.env --import tsx scripts/integration.ts",
    "test:management": "node --env-file=.env --import tsx scripts/management-integration.ts",
    "test:management-ui": "node --env-file=.env --import tsx scripts/management-browser.ts",
    "test:ui": "node --env-file=.env --import tsx scripts/browser.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.32.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "playwright": "^1.63.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "npm@11.21.0"
}
